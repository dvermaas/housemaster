# The cache is a volume, never baked into the image -- it is tens of MB and
# changes every fetch, which would bust the layer cache on every build.
data/

.venv/
.git/
.github/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.playwright-mcp/
.idea/
.vscode/
.mcp.json
.env
*.png

# The frontend stage installs and builds its own; a host node_modules (perhaps
# for another platform) or a stale build must not leak into it.
frontend/node_modules/
src/housemaster/web/dist/
